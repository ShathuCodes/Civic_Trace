# ============================================================
#  Civic Trace – Frontend .env example
#  Copy this file to .env and fill in real values.
#  Only VITE_* variables are exposed to the browser.
# ============================================================

# Base path for all API requests (proxied through Vite in dev)
VITE_API_BASE_URL=/api

# Backend origin – used by vite.config.ts to configure the dev proxy target
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Set to "true" to force standalone demo mode without a backend
VITE_DEMO_MODE=false
