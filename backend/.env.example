# ============================================================
#  Civic Trace – Backend .env example
#  Copy this file to .env and fill in real values.
#  The .env file is auto-loaded by python-dotenv at startup.
# ============================================================

# "demo" (default) or "mongodb"
DATA_MODE=demo

# Required only when DATA_MODE=mongodb
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DATABASE=civic_trace

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret token for the POST /api/trail-relationships/review endpoint
REVIEW_TOKEN=change-me-in-production

# ── Sri Lanka Hansard RAG sub-project ───────────────────────
GEMINI_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sri_lanka_hansards
LOG_LEVEL=INFO
DATA_DIR=data
